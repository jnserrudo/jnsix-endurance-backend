# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# JWT
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Strava API
STRAVA_CLIENT_ID="your-strava-client-id"
STRAVA_CLIENT_SECRET="your-strava-client-secret"
STRAVA_REDIRECT_URI="http://localhost:5000/api/auth/strava/callback"

# Supabase Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="activity-files"

# AI Providers (configurable - usar solo uno)
AI_PROVIDER="groq"
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4-turbo-preview"
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-sonnet-20240229"
GROQ_API_KEY="gsk-..."
GROQ_MODEL="llama3-70b-8192"

# App Config
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:5000"
PORT=5000
NODE_ENV="development"

# CORS — comma-separated origins merged with localhost + known prod hosts
# ALLOWED_ORIGINS="https://app.example.com,https://staging.example.com"

# Object storage — when all four are set, files go to S3-compatible storage; else local uploads/
# S3_BUCKET="jnsix-uploads"
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_ACCESS_KEY="..."
# S3_SECRET_KEY="..."
# S3_REGION="us-east-1"
# S3_PUBLIC_URL="https://cdn.example.com/jnsix-uploads"
# S3_FORCE_PATH_STYLE="true"

# Optional error tracking (no-op until @sentry/node is installed)
# SENTRY_DSN=""
# SENTRY_TRACES_SAMPLE_RATE="0.1"

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN="your-expo-access-token"

# Email (Brevo)
# MUST be loaded by the Node process. After changing these, run:
#   pm2 restart endurance-back --update-env
# Verify: curl https://your-host/health  → services.email.configured=true
BREVO_API_KEY="your-brevo-api-key"
FROM_EMAIL="no-reply@jnsix.com"
FROM_NAME="JNSIX Endurance"

# Strava Webhook
STRAVA_WEBHOOK_VERIFY_TOKEN="your-strava-webhook-verify-token"
