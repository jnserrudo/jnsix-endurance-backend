  ACCEPTED
  BLOCKED
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum CommunityType {
  REGIONAL
  TOPIC
  OFFICIAL
}

enum ReactionTarget {
  POST
  ACTIVITY
  COMMENT
}

enum ReactionType {
  LIKE
  FIRE
  CLAP
}

enum ChallengeScope {
  GLOBAL
  COMMUNITY
  GROUP
}

enum ChallengeMetric {
  DISTANCE
  ELEVATION
  FREQUENCY
  TIME
}

enum ChatRoomType {
  DIRECT
  GROUP
  COMMUNITY
}

enum NotificationType {
  FRIEND_REQUEST
  RANK_UP
  CHALLENGE_COMPLETE
  COMMENT
  CHAT_MESSAGE
  PLAN_CHANGED
  REACTION
  GROUP_INVITE
  GROUP_JOIN_REQUEST
  GROUP_JOIN_RESPONSE
  COMMUNITY_INVITE
  COMMUNITY_JOIN_REQUEST
  COMMUNITY_JOIN_RESPONSE
  SYSTEM
  POINTS_EARNED
  RANK_CHANGED
  REWARD_REDEEMED
  REWARD_AVAILABLE
  BUSINESS_PENDING
  BUSINESS_STATUS
  PAYMENT_REVIEW
  PAYMENT_APPROVED
  PAYMENT_REJECTED
