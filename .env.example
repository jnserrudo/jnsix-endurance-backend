# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# JWT
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Strava API
STRAVA_CLIENT_ID="your-strava-client-id"
STRAVA_CLIENT_SECRET="your-strava-client-secret"
STRAVA_REDIRECT_URI="http://localhost:5000/api/auth/strava/callback"

# Supabase Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="activity-files"

# AI Providers — el Coach usa AI_PROVIDER (recomendado: groq, gratis)
AI_PROVIDER="groq"
GROQ_API_KEY="gsk-..."
GROQ_MODEL="llama-3.3-70b-versatile"
# OCR de capturas: mismo Groq, pero modelo CON visión (el 70b versatile NO lee imágenes)
# Alternativas: qwen/qwen3.6-27b | meta-llama/llama-4-scout-17b-16e-instruct
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
# Límite diario de análisis OCR por usuario (además del límite de plan IA)
OCR_DAILY_LIMIT="10"
# Opcionales de pago (solo si querés otro provider)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4-turbo-preview"
OPENAI_VISION_MODEL="gpt-4o"
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-sonnet-20240229"
ANTHROPIC_VISION_MODEL="claude-3-5-sonnet-20241022"

# App Config
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:5000"
# Note: uploads (feed/stories/chat/avatars) are stored as relative /uploads/... paths.
# Do NOT bake BACKEND_URL into image URLs — the mobile app resolves the host.
PORT=5000
NODE_ENV="development"

# CORS — comma-separated origins merged with localhost + known prod hosts
# ALLOWED_ORIGINS="https://app.example.com,https://staging.example.com"

# Object storage — when all four are set, files go to S3-compatible storage; else local uploads/
# S3_BUCKET="jnsix-uploads"
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_ACCESS_KEY="..."
# S3_SECRET_KEY="..."
# S3_REGION="us-east-1"
# S3_PUBLIC_URL="https://cdn.example.com/jnsix-uploads"
# S3_FORCE_PATH_STYLE="true"

# Optional error tracking (no-op until @sentry/node is installed)
# SENTRY_DSN=""
# SENTRY_TRACES_SAMPLE_RATE="0.1"

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN="your-expo-access-token"

# Email (Brevo)
# MUST be loaded by the Node process. After changing these, run:
#   pm2 restart endurance-back --update-env
# Verify: curl https://your-host/health  → services.email.configured=true
BREVO_API_KEY="your-brevo-api-key"
FROM_EMAIL="no-reply@jnsix.com"
FROM_NAME="JNSIX Endurance"

# Strava Webhook
STRAVA_WEBHOOK_VERIFY_TOKEN="your-strava-webhook-verify-token"
