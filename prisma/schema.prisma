  ACCEPTED
  DECLINED
}

enum PlanInterval {
  MONTHLY
  YEARLY
  LIFETIME
}

enum EnforcementType {
  HARD_BLOCK
  SOFT_BLOCK
  UNLIMITED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PaymentMethod {
  IN_APP_APPLE
  IN_APP_GOOGLE
  STRIPE
  MERCADO_PAGO
  MANUAL_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REJECTED
}

model Transaction {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  planName        String        @map("plan_name")
  amount          Float
  currency        String        @default("USD")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  gatewayTxId     String?       @map("gateway_tx_id")
  receiptUrl      String?       @map("receipt_url")
  rejectionReason String?       @map("rejection_reason")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("transactions")
}

// ============================================================
// Biblioteca de Ejercicios / Entrenamiento de Fuerza
// ============================================================

model Exercise {
  id               String       @id
  name             String
  category         String
  bodyPart         String       @map("body_part")
  equipment        String
  target           String
  muscleGroup      String       @map("muscle_group")
  secondaryMuscles Json?        @map("secondary_muscles")
  instructionsEn   String       @map("instructions_en") @db.Text
  instructionsEs   String       @map("instructions_es") @db.Text
  instructionsJson Json         @map("instructions_json")
  mediaId          String?      @map("media_id")
  image            String?
  gifUrl           String?      @map("gif_url")
  attribution      String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  workoutSets      WorkoutSet[]

  @@index([category])
  @@index([equipment])
  @@index([target])
  @@map("exercises")
}

model WorkoutSession {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  name        String       @default("Entrenamiento de fuerza")
  notes       String?      @db.Text
  startedAt   DateTime     @default(now()) @map("started_at")
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets        WorkoutSet[]

  @@index([userId])
  @@map("workout_sessions")
}

model WorkoutSet {
  id          String         @id @default(uuid())
  sessionId   String         @map("session_id")
  exerciseId  String         @map("exercise_id")
  setNumber   Int            @map("set_number")
  reps        Int?
  weightKg    Float?         @map("weight_kg")
  restSeconds Int?           @map("rest_seconds")
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise    Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([exerciseId])
  @@map("workout_sets")
}

model Achievement {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  iconUrl     String?  @map("icon_url")
  criteria    Json?
  points      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  achievementId String      @map("achievement_id")
  unlockedAt    DateTime    @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}


// ============================================================
// Gamificación - Misiones y Rachas
// ============================================================

model Mission {
  id          String   @id @default(uuid())
  name        String
  description String
  type        String   // Ej: "WEEKLY_DISTANCE", "CONSISTENCY"
  targetValue Float
  rewardPts   Int      @default(0)
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  userMissions UserMission[]

  @@map("missions")
}

model UserMission {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  missionId       String   @map("mission_id")
  currentProgress Float    @default(0)
  completed       Boolean  @default(false)
  completedAt     DateTime?
  
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@index([userId])
  @@map("user_missions")
}

model Streak {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActivityAt DateTime?
  updatedAt      DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

// ============================================================
// Entrenamiento y Planes IA
// ============================================================

model TrainingPlan {
  id          String   @id @default(uuid())
  name        String
  description String?
  level       String   // BEGINNER, INTERMEDIATE, ADVANCED
  weeks       Int
  createdAt   DateTime @default(now())

  sessions  PlanSession[]
  userPlans UserPlan[]

  @@map("training_plans")
}

model PlanSession {
  id             String   @id @default(uuid())
  trainingPlanId String   @map("training_plan_id")
  week           Int
  day            Int
  name           String
  description    String?  @db.Text
  targetMetric   String?  // Ej: DISTANCE, TIME
  targetValue    Float?
  
  plan TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)

  @@index([trainingPlanId])
  @@map("plan_sessions")
}

model UserPlan {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  trainingPlanId String   @map("training_plan_id")
  startDate      DateTime
  isActive       Boolean  @default(true)
  completed      Boolean  @default(false)
  
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_plans")
}

model EffortLog {
  id         String   @id @default(uuid())
  activityId String   @unique @map("activity_id")
  userId     String   @map("user_id")
  rpe        Int      // Rate of Perceived Exertion 1-10
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("effort_logs")
}

// ============================================================
// Historias y Social Expandido
// ============================================================

model Story {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  mediaUrl  String   @map("media_url")
  mediaType String   // IMAGE, VIDEO
  caption   String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  views StoryView[]

  @@index([userId])
  @@index([expiresAt])
  @@map("stories")
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String   @map("story_id")
  userId    String   @map("user_id")
  viewedAt  DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@map("story_views")
}

// ============================================================
// Segmentos y Live Challenges (Innovaciones)
// ============================================================

model Segment {
  id          String   @id @default(uuid())
  name        String
  description String?
  startCoords Json     // [lat, lng]
  endCoords   Json     // [lat, lng]
  polyline    String   @db.Text
  distanceKm  Float
  createdAt   DateTime @default(now())

  leaderboards SegmentLeaderboard[]

  @@map("segments")
}

model SegmentLeaderboard {
  id         String   @id @default(uuid())
  segmentId  String   @map("segment_id")
  userId     String   @map("user_id")
  activityId String   @map("activity_id")
  timeSeconds Int
  date       DateTime

  segment  Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([segmentId])
  @@index([userId])
  @@map("segment_leaderboards")
}

model LiveChallenge {
  id          String   @id @default(uuid())
  name        String
  description String?
  scheduledAt DateTime
  status      String   // SCHEDULED, IN_PROGRESS, COMPLETED
  createdAt   DateTime @default(now())

  @@map("live_challenges")
}
